# Root environment for docker-compose
# Copy to .env and adjust as needed.

# --- Postgres ---
POSTGRES_USER=kibble
POSTGRES_PASSWORD=karma
POSTGRES_DB=kibble_karma
# DB_PORT is only needed if you uncomment db ports in docker-compose.yml for host-level DB access.
DB_PORT=5432

# --- Backend ---
# BACKEND_PORT is only needed if you uncomment backend ports in docker-compose.yml.
BACKEND_PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
CORS_ORIGIN=*
# First user enrolls on first run; set true to allow more accounts later.
ALLOW_OPEN_REGISTRATION=true

# --- Open Food Facts integration ---
OFF_BASE_URL=https://world.openfoodfacts.org
OFF_USER_AGENT=KibbleKarma/1.0 (self-hosted)
OFF_TIMEOUT_MS=8000

# --- Frontend ---
FRONTEND_PORT=80
