# Root environment for docker-compose
# Copy to .env and adjust as needed.

# --- Postgres ---
POSTGRES_USER=nibbles
POSTGRES_PASSWORD=naps
POSTGRES_DB=nibbles_and_naps
DB_PORT=5432

# --- Backend ---
BACKEND_PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
CORS_ORIGIN=*

# --- Open Food Facts integration ---
OFF_BASE_URL=https://world.openfoodfacts.org
OFF_USER_AGENT=NibblesAndNaps/1.0 (self-hosted)
OFF_TIMEOUT_MS=8000

# --- Frontend ---
FRONTEND_PORT=8080
